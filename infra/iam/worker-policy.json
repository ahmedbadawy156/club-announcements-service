{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOwnInboxOnly",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:us-east-1:000000000000:club-announcements-inbox"
    },
    {
      "Sid": "WriteAnnouncementsNoDeleteNoQuery",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/Announcements"
    },
    {
      "Sid": "OwnLogGroupOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/club-announcements-worker",
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/club-announcements-worker:*"
      ]
    }
  ]
}
