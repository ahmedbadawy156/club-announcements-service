# Copy to backend/.env (ignored by Git) to run the API on your PC with
# npm run dev against the tables in Floci. Nothing here is secret: Floci uses
# fake test keys from the "floci" AWS profile, and the token public key is
# public by design.
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:4566

AWS_PROFILE=floci
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

ANNOUNCEMENTS_TABLE=Announcements
ACTIVITIES_TABLE=Activities

# Base64 of the Membership service's PUBLIC key (PEM). infra/deploy.sh sets it
# on the Lambda function automatically. For npm run dev, paste the value from
# infra/out/public-key.b64 after a deploy.
JWT_PUBLIC_KEY_B64=
